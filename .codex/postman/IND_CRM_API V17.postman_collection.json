        {
          "name": "Entra Context",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "try {",
                  "  var json = pm.response.json();",
                  "  var items = json.items || json.Items;",
                  "  if (!items || !items.length) return;",
                  "  var first = items[0];",
                  "  var header = first.Header || first.header || {};",
                  "  var axUserId = header.AxUserId || header.axUserId;",
                  "  if (axUserId) {",
                  "    pm.collectionVariables.set('axUserId', axUserId);",
                  "  }",
                  "  var defaultCurrencyCode = header.DefaultCurrencyCode || header.defaultCurrencyCode;",
                  "  if (defaultCurrencyCode) {",
                  "    pm.collectionVariables.set('defaultCurrencyCode', defaultCurrencyCode);",
                  "  }",
                  "  var defaultCompany = header.DefaultCompany || header.defaultCompany;",
                  "  if (defaultCompany) {",
                  "    pm.collectionVariables.set('companyId', defaultCompany);",
                  "    return;",
                  "  }",
                  "  var companies = first.Companies || first.companies || [];",
                  "  if (companies.length > 0) {",
                  "    var selected = companies.find(function(c){ return c.IsDefault || c.isDefault; }) || companies[0];",
                  "    var companyId = selected.CompanyId || selected.companyId;",
                  "    if (companyId) {",
                  "      pm.collectionVariables.set('companyId', companyId);",
                  "    }",
                  "    var companyCurrencyCode = selected.CurrencyCode || selected.currencyCode;",
                  "    if (companyCurrencyCode && !pm.collectionVariables.get('defaultCurrencyCode')) {",
                  "      pm.collectionVariables.set('defaultCurrencyCode', companyCurrencyCode);",
                  "    }",
                  "  }",
                  "} catch (e) {}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
