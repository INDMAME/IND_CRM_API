    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "try {",
                  "  var json = pm.response.json();",
                  "  var data = json.data || json.Data;",
                  "  if (!(data && data.token)) {",
                  "    console.warn('Login sin token en la respuesta.');",
                  "  } else {",
                  "    var token = data.token;",
                  "    pm.collectionVariables.set('tokenId', token);",
                  "",
                  "    var baseUrl = pm.collectionVariables.get('baseUrl');",
                  "    var entraOid = pm.collectionVariables.get('entraOid');",
                  "    var appCode = pm.collectionVariables.get('appCode') || 'CRM';",
                  "",
                  "    if (!baseUrl || !entraOid) {",
                  "      console.warn('Auto Entra Context omitido: faltan baseUrl o entraOid.');",
                  "    } else {",
                  "      pm.sendRequest({",
                  "        url: baseUrl + '/api/auth/entra/context',",
                  "        method: 'POST',",
                  "        header: {",
                  "          'Authorization': 'Bearer ' + token,",
                  "          'Content-Type': 'application/json'",
                  "        },",
                  "        body: {",
                  "          mode: 'raw',",
                  "          raw: JSON.stringify({ entraOid: entraOid, appCode: appCode })",
                  "        }",
                  "      }, function (err, res) {",
                  "        if (err || !res) {",
                  "          console.error('Auto Entra Context error:', err);",
                  "          return;",
                  "        }",
                  "",
                  "        if (res.code < 200 || res.code >= 300) {",
                  "          console.error('Auto Entra Context HTTP ' + res.code + ': ' + res.text());",
                  "          return;",
                  "        }",
                  "",
                  "        try {",
                  "          var entraJson = res.json();",
                  "          var items = entraJson.items || entraJson.Items || [];",
                  "          if (!items.length) {",
                  "            console.warn('Auto Entra Context sin items.');",
                  "            return;",
                  "          }",
                  "",
                  "          var first = items[0] || {};",
                  "          var header = first.Header || first.header || {};",
                  "          var axUserId = header.AxUserId || header.axUserId;",
                  "          if (axUserId) {",
                  "            pm.collectionVariables.set('axUserId', axUserId);",
                  "          }",
                  "",
                  "          var defaultCompany = header.DefaultCompany || header.defaultCompany;",
                  "          if (defaultCompany) {",
                  "            pm.collectionVariables.set('companyId', defaultCompany);",
                  "          } else {",
                  "            var companies = first.Companies || first.companies || [];",
                  "            if (companies.length > 0) {",
                  "              var selected = companies.find(function(c){ return c.IsDefault || c.isDefault; }) || companies[0];",
                  "              var companyId = selected.CompanyId || selected.companyId;",
                  "              if (companyId) {",
                  "                pm.collectionVariables.set('companyId', companyId);",
                  "              }",
                  "            }",
                  "          }",
                  "        } catch (parseErr) {",
                  "          console.error('Auto Entra Context parse error:', parseErr);",
                  "        }",
                  "      });",
                  "    }",
                  "  }",
                  "} catch (e) {",
                  "  console.error('Login test script error:', e);",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"Username\": \"{{username}}\",\n  \"Password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          },
          "response": []
        },
