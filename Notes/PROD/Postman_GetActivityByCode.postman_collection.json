{
  "info": {
    "_postman_id": "5e2c9c6b-5a9a-4c9c-9c21-9d2c9dbf5f6a",
    "name": "IND_CRM_API - GetActivityByCode",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Colección mínima para autenticar y consumir GET /api/crm/activities/by-code/{code}. Ajusta variables base_url, username, password, code."
  },
  "item": [
    {
      "name": "Auth - Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"Username\": \"{{username}}\",\n    \"Password\": \"{{password}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "  const json = pm.response.json();",
              "  if (json && json.data && json.data.token) {",
              "    pm.environment.set('token', json.data.token);",
              "    console.log('token guardado en entorno');",
              "  }",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Activities - GetActivityByCode",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/crm/activities/by-code/{{code}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "crm",
            "activities",
            "by-code",
            "{{code}}"
          ]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:7776"
    },
    {
      "key": "username",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "code",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    }
  ]
}
