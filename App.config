<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- ===========================================================
                  CONFIGURACIÓN GENERAL DEL HOST
       =========================================================== -->
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <appSettings>
	  
    <!-- ===========================================================
        CONFIGURACIÓN DE CONEXIÓN AXAPTA 3.0 (Business Connector)
        ===========================================================
        Estas claves son utilizadas por la clase AxaptaSessionManager
        para establecer la conexión COM hacia el entorno Axapta 3.0.
        =========================================================== -->
    <!-- Ruta completa al archivo de configuración AXC -->
    <add key="AxConfigFile" value="%INDCRM_AX_CONFIG_FILE%" />
    <!-- Credenciales por defecto de conexion a Axapta (usar variables de entorno) -->
    <add key="Axapta.User" value="%USER_DEFAULT%" />
    <add key="Axapta.Password" value="%USER_PASS_DEFAULT%" />
    <!-- No guardar ni comentar passwords reales en repositorio -->
    <!-- Nivel de verbosidad del log interno (true = log extendido) -->
    <add key="Axapta.VerboseLogging" value="%INDCRM_AX_VERBOSE_LOGGING%" />
    <add key="Axapta.VerboseLogPath" value="%INDCRM_AX_VERBOSE_LOG_PATH%" />
    <!-- Nivel mínimo de severidad que se registrará en el log:
    Valores posibles: Info | Warning | Error -->
    <add key="LogLevel" value="%INDCRM_LOG_LEVEL%" />
    
    <!--Si la pones a false, el manager no usara _defaultUser / _defaultPass cuando no lleguen credenciales.-->
    <add key="Axapta.AllowDefaultCredentials" value="%INDCRM_AX_ALLOW_DEFAULT_CREDENTIALS%" />
	  
    <!-- ===========================================================
    CONFIGURACIÓN BASE DEL SERVICIO WEB (SelfHost)
    ============a===============================================
    Estas opciones son leídas por la clase WebApiService (Program.cs)
    para definir la URL y puerto en el que se levantará el servicio.
    =========================================================== -->
    <!-- URL base del servicio (produccion usa HTTPS con crm.insertec.biz) -->
    <add key="BaseUrl" value="%INDCRM_BASE_URL%" />
    <!-- Metadata operativa del despliegue para validar la separacion DEV/PROD. -->
    <add key="Deployment:EnvironmentName" value="%IND_ENV%" />
    <add key="PublicEndpoint:Host" value="%INDCRM_PUBLIC_HOST%" />
    <add key="PublicEndpoint:Ip" value="%INDCRM_PUBLIC_IP%" />
    <add key="PublicEndpoint:Port" value="%INDCRM_PUBLIC_PORT%" />
    <!-- Configuracion CORS (deshabilitado por defecto) -->
    <add key="CorsSettings:Enabled" value="%INDCRM_CORS_ENABLED%" />
    <!-- Origenes permitidos separados por coma o punto y coma -->
    <add key="CorsSettings:AllowedOrigins" value="%INDCRM_CORS_ALLOWED_ORIGINS%" />
    <!-- ===========================================================
         CONFIGURACIÓN JWT (Autenticación)
        ===========================================================
        Leídas por JwtService y Startup.cs para generar y validar tokens.
        =========================================================== -->
    <!-- Emisor del token JWT (Issuer) -->
    <add key="JwtSettings:Issuer" value="%INDCRM_JWT_ISSUER%" />
    <!-- Audiencia esperada (Audience) -->
    <add key="JwtSettings:Audience" value="%INDCRM_JWT_AUDIENCE%" />
    <!-- Clave secreta simetrica usada para firmar los tokens JWT (usar variable de entorno) -->
    <add key="JwtSettings:SecretKey" value="%JWT_SECRET_KEY%" />
    <!-- Tiempo de expiración de los tokens en minutos -->
    <add key="JwtSettings:ExpirationMinutes" value="%INDCRM_JWT_EXPIRATION_MINUTES%" />
    <add key="JwtSettings:RefreshThresholdMinutes" value="%INDCRM_JWT_REFRESH_THRESHOLD_MINUTES%" />

    <!-- ===========================================================
         OPENAI (Speech-to-Text)
         - No subir la API key real a control de codigo.
         - En produccion, preferir la variable de entorno OPENAI_API_KEY.
         - Prompt por defecto (contexto): mejor en fichero externo y configurado por ruta.
        =========================================================== -->
    <add key="OpenAI:ApiKey" value="%OPENAI_API_KEY%" />
    <add key="OpenAI:AudioModel" value="%OPENAI_AUDIO_MODEL%" />
    <add key="OpenAI:ExpenseTicketModel" value="%OPENAI_EXPENSE_TICKET_MODEL%" />
    <add key="OpenAI:ExpenseSheetAskModel" value="%OPENAI_EXPENSE_SHEET_ASK_MODEL%" />
    <add key="OpenAI:ExpenseSheetAskTimeoutSeconds" value="%OPENAI_EXPENSE_SHEET_ASK_TIMEOUT_SECONDS%" />
    <add key="OpenAI:ExpenseSheetAskMaxOutputTokens" value="%OPENAI_EXPENSE_SHEET_ASK_MAX_OUTPUT_TOKENS%" />
    <add key="OpenAI:ExpenseSheetAskChunkMaxOutputTokens" value="%OPENAI_EXPENSE_SHEET_ASK_CHUNK_MAX_OUTPUT_TOKENS%" />
    <add key="OpenAI:ExpenseSheetAskDirectRecordLimit" value="%OPENAI_EXPENSE_SHEET_ASK_DIRECT_RECORD_LIMIT%" />
    <add key="OpenAI:ExpenseSheetAskChunkSize" value="%OPENAI_EXPENSE_SHEET_ASK_CHUNK_SIZE%" />
    <add key="OpenAI:ExpenseSheetAskMaxChunks" value="%OPENAI_EXPENSE_SHEET_ASK_MAX_CHUNKS%" />
    <add key="OpenAI:ExpenseSheetAskServiceTier" value="%OPENAI_EXPENSE_SHEET_ASK_SERVICE_TIER%" />
    <add key="OpenAI:ExpenseSheetAskProfileTag" value="%OPENAI_EXPENSE_SHEET_ASK_PROFILE_TAG%" />
    <add key="OpenAI:ExpenseSheetAskPromptCacheKey" value="%OPENAI_EXPENSE_SHEET_ASK_PROMPT_CACHE_KEY%" />
    <add key="OpenAI:ExpenseSheetAskReasoningEffort" value="%OPENAI_EXPENSE_SHEET_ASK_REASONING_EFFORT%" />
    <add key="OpenAI:ExpenseTicketMaxOutputTokens" value="%OPENAI_EXPENSE_TICKET_MAX_OUTPUT_TOKENS%" />
    <add key="OpenAI:ExpenseTicketImageDetail" value="%OPENAI_EXPENSE_TICKET_IMAGE_DETAIL%" />
    <add key="OpenAI:ExpenseTicketServiceTier" value="%OPENAI_EXPENSE_TICKET_SERVICE_TIER%" />
    <add key="OpenAI:ExpenseTicketProfileTag" value="%OPENAI_EXPENSE_TICKET_PROFILE_TAG%" />
    <add key="OpenAI:ExpenseTicketPromptCacheKey" value="%OPENAI_EXPENSE_TICKET_PROMPT_CACHE_KEY%" />
    <add key="OpenAI:ExpenseTicketReasoningEffort" value="%OPENAI_EXPENSE_TICKET_REASONING_EFFORT%" />
    <add key="OpenAI:ExpenseTicketQuickCreateMaxOutputTokens" value="%OPENAI_EXPENSE_TICKET_QUICK_CREATE_MAX_OUTPUT_TOKENS%" />
    <add key="OpenAI:ExpenseTicketQuickCreateImageDetail" value="%OPENAI_EXPENSE_TICKET_QUICK_CREATE_IMAGE_DETAIL%" />
    <add key="OpenAI:ExpenseTicketQuickCreateServiceTier" value="%OPENAI_EXPENSE_TICKET_QUICK_CREATE_SERVICE_TIER%" />
    <add key="OpenAI:ExpenseTicketQuickCreateProfileTag" value="%OPENAI_EXPENSE_TICKET_QUICK_CREATE_PROFILE_TAG%" />
    <add key="OpenAI:ExpenseTicketQuickCreatePromptCacheKey" value="%OPENAI_EXPENSE_TICKET_QUICK_CREATE_PROMPT_CACHE_KEY%" />
    <add key="OpenAI:ExpenseTicketQuickCreateReasoningEffort" value="%OPENAI_EXPENSE_TICKET_QUICK_CREATE_REASONING_EFFORT%" />
    <add key="OpenAI:TranscriptionPromptMaxWords" value="%OPENAI_TRANSCRIPTION_PROMPT_MAX_WORDS%" />
    <add key="OpenAI:TranscriptionDefaultPromptFile" value="%OPENAI_TRANSCRIPTION_DEFAULT_PROMPT_PATH%" />
    <add key="OpenAI:TranscriptionDefaultPrompt" value="%OPENAI_TRANSCRIPTION_DEFAULT_PROMPT%" />
    <add key="OpenAI:ExpenseTicketTimeoutSeconds" value="%OPENAI_EXPENSE_TICKET_TIMEOUT_SECONDS%" />
    <add key="OpenAI:ExpenseTicketMaxImageBytes" value="%OPENAI_EXPENSE_TICKET_MAX_IMAGE_BYTES%" />
    <add key="OpenAI:ModerationModel" value="%OPENAI_MODERATION_MODEL%" />
    <!-- OpenAI request timeout in seconds (server side). -->
    <add key="OpenAI:TimeoutSeconds" value="%OPENAI_TIMEOUT_SECONDS%" />
    <!-- Temporary switch for IA endpoint limit validation tests. Set to true to re-enable limits. -->
    <add key="OpenAI:RateLimitEnabled" value="%OPENAI_RATE_LIMIT_ENABLED%" />
    <!-- OpenAI endpoint limits (per authenticated user). -->
    <add key="OpenAI:RateLimitSpeechMaxRequests" value="%OPENAI_RATE_LIMIT_SPEECH_MAX_REQUESTS%" />
    <add key="OpenAI:RateLimitSpeechWindowSeconds" value="%OPENAI_RATE_LIMIT_SPEECH_WINDOW_SECONDS%" />
    <add key="OpenAI:RateLimitExpenseTicketMaxRequests" value="%OPENAI_RATE_LIMIT_EXPENSE_TICKET_MAX_REQUESTS%" />
    <add key="OpenAI:RateLimitExpenseTicketWindowSeconds" value="%OPENAI_RATE_LIMIT_EXPENSE_TICKET_WINDOW_SECONDS%" />
    <add key="OpenAI:RateLimitMaxConcurrentPerUser" value="%OPENAI_RATE_LIMIT_MAX_CONCURRENT_PER_USER%" />
    <add key="OpenAI:RateLimitValidationMultiplier" value="%OPENAI_RATE_LIMIT_VALIDATION_MULTIPLIER%" />
 	<!-- Tiempo de time out para CallMethodByUser en segundos -->
 	<add key="Axapta.CallTimeoutSeconds" value="%AXAPTA_CALL_TIMEOUT_SECONDS%" />

    <!-- ===========================================================
         AZURE BLOB STORAGE (Tickets)
         - Definir la cadena como variable de entorno.
         - No subir keys/cadenas reales al repositorio.
        =========================================================== -->
    <add key="AzureBlob:ConnectionString" value="%AZURE_BLOB_CONNECTION_STRING%" />
    <add key="AzureBlob:Container" value="%AZURE_BLOB_CONTAINER%" />
    <!-- Entorno logico para rutas tipo DEV/TICKET/<companyId> o PROD/TICKET/<companyId>. -->
    <add key="AzureBlob:EnvironmentSegment" value="%AZURE_BLOB_ENVIRONMENT_SEGMENT%" />
    <add key="AzureDocsIA:Key" value="%AZURE_DOCS_IA_KEY%" />
    <add key="AzureDocsIA:Endpoint" value="%AZURE_DOCS_IA_ENDPOINT%" />
    <add key="AzureDocsIA:Model" value="%AZURE_DOCS_IA_MODEL%" />
    <add key="AzureDocsIA:ApiVersion" value="%AZURE_DOCS_IA_API_VERSION%" />
    <add key="AzureDocsIA:PollIntervalMs" value="%AZURE_DOCS_IA_POLL_INTERVAL_MS%" />
    <add key="AzureDocsIA:TimeoutSeconds" value="%AZURE_DOCS_IA_TIMEOUT_SECONDS%" />
    <add key="AzureDocsIA:BlobReadSasMinutes" value="%AZURE_DOCS_IA_BLOB_READ_SAS_MINUTES%" />
    <!-- ===========================================================
         EXCHANGE RATES (ECB + FRANKFURTER + OPEN_ER_API)
        =========================================================== -->
    <add key="ExchangeRate:EcbTimeoutSeconds" value="%EXCHANGE_RATE_ECB_TIMEOUT_SECONDS%" />
    <add key="ExchangeRate:FrankfurterTimeoutSeconds" value="%EXCHANGE_RATE_FRANKFURTER_TIMEOUT_SECONDS%" />
    <add key="ExchangeRate:OpenErApiTimeoutSeconds" value="%EXCHANGE_RATE_OPEN_ER_API_TIMEOUT_SECONDS%" />

	  <!-- ===========================================================
         AJUSTES ADICIONALES
        =========================================================== -->
    <!-- Ruta de logs estándar (fallback si no se define Axapta.VerboseLogPath) -->
    <add key="LogPath" value="%INDCRM_LOG_PATH%" />
    <add key="CompanyAccessCache:Minutes" value="%COMPANY_ACCESS_CACHE_MINUTES%" />
    <add key="ClientSettingsProvider.ServiceUri" value="%CLIENT_SETTINGS_PROVIDER_SERVICE_URI%" />
  </appSettings>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Http" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-5.2.9.0" newVersion="5.2.9.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Net.Http.Formatting" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-5.2.9.0" newVersion="5.2.9.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.Owin" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.2.3.0" newVersion="4.2.3.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.Owin.Security" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.2.2.0" newVersion="4.2.2.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.Owin.Security.Jwt" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.2.2.0" newVersion="4.2.2.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.Owin.Security.OAuth" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.2.2.0" newVersion="4.2.2.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-13.0.0.0" newVersion="13.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Http.Owin" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-5.2.9.0" newVersion="5.2.9.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
  <system.diagnostics>
    <trace autoflush="true" indentsize="4">
      <listeners>
        <add name="consoleListener" type="System.Diagnostics.ConsoleTraceListener" />
        <remove name="Default" />
      </listeners>
    </trace>
    <sharedListeners>
      <add name="fileListener" type="System.Diagnostics.TextWriterTraceListener" initializeData="C:\INDAxaptaLogs\SelfHost_Trace.log" />
    </sharedListeners>
    <sources>
      <source name="System.Net" tracemode="includehex" maxdatasize="1024">
        <listeners>
          <add name="fileListener" />
        </listeners>
      </source>
      <source name="System.Net.Http">
        <listeners>
          <add name="fileListener" />
        </listeners>
      </source>
    </sources>
    <switches>
      <add name="System.Net" value="Verbose" />
      <add name="System.Net.Http" value="Verbose" />
    </switches>
  </system.diagnostics>
  <system.web>
    <membership defaultProvider="ClientAuthenticationMembershipProvider">
      <providers>
        <add name="ClientAuthenticationMembershipProvider" type="System.Web.ClientServices.Providers.ClientFormsAuthenticationMembershipProvider, System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" serviceUri="" />
      </providers>
    </membership>
    <roleManager defaultProvider="ClientRoleProvider" enabled="true">
      <providers>
        <add name="ClientRoleProvider" type="System.Web.ClientServices.Providers.ClientRoleProvider, System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" serviceUri="" cacheTimeout="86400" />
      </providers>
    </roleManager>
  </system.web>
</configuration>
