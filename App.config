<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- ===========================================================
                  CONFIGURACIÓN GENERAL DEL HOST
       =========================================================== -->
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <appSettings>
	  
    <!-- ===========================================================
        CONFIGURACIÓN DE CONEXIÓN AXAPTA 3.0 (Business Connector)
        ===========================================================
        Estas claves son utilizadas por la clase AxaptaSessionManager
        para establecer la conexión COM hacia el entorno Axapta 3.0.
        =========================================================== -->
    <!-- Ruta completa al archivo de configuración AXC -->
    <add key="AxConfigFile" value="C:\INDAxaptaConfigAPI\CRM_API_AxConfig.axc" />
    <!-- Credenciales por defecto de conexion a Axapta (usar variables de entorno) -->
    <add key="Axapta.User" value="%USER_DEFAULT%" />
    <add key="Axapta.Password" value="%USER_PASS_DEFAULT%" />
		<!--<add key="Axapta.Password" value="MaMeAxAp#48" />-->
    <!-- Nivel de verbosidad del log interno (true = log extendido) -->
    <add key="Axapta.VerboseLogging" value="true" />
    <add key="Axapta.VerboseLogPath" value="C:\INDAxaptaLogs" />
    <!-- Nivel mínimo de severidad que se registrará en el log:
    Valores posibles: Info | Warning | Error -->
    <add key="LogLevel" value="Info" />
    
    <!--Si la pones a false, el manager no usara _defaultUser / _defaultPass cuando no lleguen credenciales.-->
    <add key="Axapta.AllowDefaultCredentials" value="false" />
	  
    <!-- ===========================================================
    CONFIGURACIÓN BASE DEL SERVICIO WEB (SelfHost)
    ============a===============================================
    Estas opciones son leídas por la clase WebApiService (Program.cs)
    para definir la URL y puerto en el que se levantará el servicio.
    =========================================================== -->
    <!-- URL base del servicio (produccion usa HTTPS con crm.insertec.biz) -->
    <add key="BaseUrl" value="https://crm.insertec.biz:7776/" />
    <!-- Configuracion CORS (deshabilitado por defecto) -->
    <add key="CorsSettings:Enabled" value="false" />
    <!-- Origenes permitidos separados por coma o punto y coma -->
    <add key="CorsSettings:AllowedOrigins" value="" />
    <!-- ===========================================================
         CONFIGURACIÓN JWT (Autenticación)
        ===========================================================
        Leídas por JwtService y Startup.cs para generar y validar tokens.
        =========================================================== -->
    <!-- Emisor del token JWT (Issuer) -->
    <add key="JwtSettings:Issuer" value="IND_CRM_API" />
    <!-- Audiencia esperada (Audience) -->
    <add key="JwtSettings:Audience" value="IND_CRM_APIUsers" />
    <!-- Clave secreta simetrica usada para firmar los tokens JWT (usar variable de entorno) -->
    <add key="JwtSettings:SecretKey" value="%JWT_SECRET_KEY%" />
    <!-- Tiempo de expiración de los tokens en minutos -->
    <add key="JwtSettings:ExpirationMinutes" value="60" />

    <!-- ===========================================================
         OPENAI (Speech-to-Text)
         - No subir la API key real a control de codigo.
         - En produccion, preferir la variable de entorno OPENAI_API_KEY.
         - Prompt por defecto (contexto): mejor en fichero externo y configurado por ruta.
        =========================================================== -->
    <add key="OpenAI:ApiKey" value="" />
    <add key="OpenAI:AudioModel" value="gpt-4o-transcribe" />
    <add key="OpenAI:ExpenseTicketModel" value="gpt-4o" />
    <add key="OpenAI:TranscriptionPromptMaxWords" value="500" />
    <add key="OpenAI:TranscriptionDefaultPromptFile" value="C:\INDAxaptaConfigAPI\Prompts\Wisper\prompt.txt" />
    <add key="OpenAI:TranscriptionDefaultPrompt" value="" />
    <add key="OpenAI:ExpenseTicketTimeoutSeconds" value="180" />
    <add key="OpenAI:ExpenseTicketMaxImageBytes" value="52428800" />
    <add key="OpenAI:ModerationModel" value="omni-moderation-latest" />
    <!-- OpenAI request timeout in seconds (server side). -->
    <add key="OpenAI:TimeoutSeconds" value="600" />
    <!-- OpenAI endpoint limits (per authenticated user). -->
    <add key="OpenAI:RateLimitSpeechMaxRequests" value="5" />
    <add key="OpenAI:RateLimitSpeechWindowSeconds" value="300" />
    <add key="OpenAI:RateLimitExpenseTicketMaxRequests" value="10" />
    <add key="OpenAI:RateLimitExpenseTicketWindowSeconds" value="600" />
    <add key="OpenAI:RateLimitMaxConcurrentPerUser" value="1" />
 	<!-- Tiempo de time out para CallMethodByUser en segundos -->
 	<add key="Axapta.CallTimeoutSeconds" value="3600" />

    <!-- ===========================================================
         AZURE BLOB STORAGE (Tickets)
         - Definir la cadena como variable de entorno.
         - No subir keys/cadenas reales al repositorio.
        =========================================================== -->
    <add key="AzureBlob:ConnectionString" value="%AZURE_BLOB_CONNECTION_STRING%" />
    <add key="AzureBlob:Container" value="tickets" />
    <add key="AzureBlob:BasePrefix" value="tickets" />

	  <!-- ===========================================================
         AJUSTES ADICIONALES
        =========================================================== -->
    <!-- Ruta de logs estándar (fallback si no se define Axapta.VerboseLogPath) -->
    <add key="LogPath" value="C:\INDAxaptaLogs\" />
    <add key="ClientSettingsProvider.ServiceUri" value="" />
  </appSettings>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Http" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-5.2.9.0" newVersion="5.2.9.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Net.Http.Formatting" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-5.2.9.0" newVersion="5.2.9.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.Owin" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.2.3.0" newVersion="4.2.3.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.Owin.Security" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.2.2.0" newVersion="4.2.2.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.Owin.Security.Jwt" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.2.2.0" newVersion="4.2.2.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.Owin.Security.OAuth" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.2.2.0" newVersion="4.2.2.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-13.0.0.0" newVersion="13.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Http.Owin" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-5.2.9.0" newVersion="5.2.9.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
  <system.diagnostics>
    <trace autoflush="true" indentsize="4">
      <listeners>
        <add name="consoleListener" type="System.Diagnostics.ConsoleTraceListener" />
        <remove name="Default" />
      </listeners>
    </trace>
    <sharedListeners>
      <add name="fileListener" type="System.Diagnostics.TextWriterTraceListener" initializeData="C:\INDAxaptaLogs\SelfHost_Trace.log" />
    </sharedListeners>
    <sources>
      <source name="System.Net" tracemode="includehex" maxdatasize="1024">
        <listeners>
          <add name="fileListener" />
        </listeners>
      </source>
      <source name="System.Net.Http">
        <listeners>
          <add name="fileListener" />
        </listeners>
      </source>
    </sources>
    <switches>
      <add name="System.Net" value="Verbose" />
      <add name="System.Net.Http" value="Verbose" />
    </switches>
  </system.diagnostics>
  <system.web>
    <membership defaultProvider="ClientAuthenticationMembershipProvider">
      <providers>
        <add name="ClientAuthenticationMembershipProvider" type="System.Web.ClientServices.Providers.ClientFormsAuthenticationMembershipProvider, System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" serviceUri="" />
      </providers>
    </membership>
    <roleManager defaultProvider="ClientRoleProvider" enabled="true">
      <providers>
        <add name="ClientRoleProvider" type="System.Web.ClientServices.Providers.ClientRoleProvider, System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" serviceUri="" cacheTimeout="86400" />
      </providers>
    </roleManager>
  </system.web>
</configuration>
